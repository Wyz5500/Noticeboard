{
  "name": "noticeboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "告示牌（Noticeboard）任务协作平台的 NestJS、PostgreSQL 与原生 TypeScript 单体应用。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "architecture": "node --import tsx scripts/check-architecture.ts",
    "build": "npm run clean && npm run build:api && npm run build:web && node scripts/copy-web-assets.mjs",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "tsc -p apps/web/tsconfig.json",
    "clean": "rimraf coverage dist playwright-report test-results",
    "comments": "node --import tsx scripts/check-comments.ts",
    "db:migrate": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts migration:run",
    "db:revert": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts migration:revert",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts seed",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:check": "npm run build:api && node --import tsx scripts/openapi-artifact.ts check",
    "openapi:compatibility": "node --import tsx scripts/check-openapi-compatibility.ts",
    "openapi:generate": "npm run build:api && node --import tsx scripts/openapi-artifact.ts generate",
    "start": "node dist/api/main.js",
    "start:dev": "node scripts/run-local.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:api": "vitest run --config vitest.http.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "node scripts/run-playwright.mjs e2e",
    "test:instance": "node --test scripts/instance.spec.mjs scripts/local-app.spec.mjs scripts/verify.spec.mjs scripts/deploy.spec.mjs scripts/release.spec.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:visual": "node scripts/run-playwright.mjs visual",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "instance": "node scripts/instance.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.11.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.3",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "fsevents": false
  }
}
