{
  "name": "noticeboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "告示牌（Noticeboard）任务协作平台的 NestJS、PostgreSQL 与原生 TypeScript 单体应用。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "architecture": "node --import tsx scripts/check-architecture.ts",
    "build": "npm run clean && npm run build:api && npm run build:web && npm run sdk:build && npm run cli:build && node scripts/copy-web-assets.mjs",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "tsc -p apps/web/tsconfig.json",
    "clean": "rimraf coverage dist playwright-report test-results",
    "client:check": "node --import tsx scripts/generated-transport.ts check",
    "client:generate": "node --import tsx scripts/generated-transport.ts generate",
    "cli:build": "node scripts/build-cli.mjs",
    "cli:install:local": "node scripts/install-cli-local.mjs",
    "cli:pack": "node scripts/pack-client.mjs cli",
    "cli:typecheck": "tsc -p apps/cli/tsconfig.cli.json --noEmit",
    "cli:pack:check": "vitest run --config vitest.config.ts tests/cli/package.spec.ts",
    "comments": "node --import tsx scripts/check-comments.ts",
    "db:migrate": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts migration:run",
    "db:revert": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts migration:revert",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database-cli.ts seed",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "instance": "node scripts/instance.mjs",
    "lint": "eslint .",
    "openapi:check": "npm run build:api && node --import tsx scripts/openapi-artifact.ts check",
    "openapi:compatibility": "node --import tsx scripts/check-openapi-compatibility.ts",
    "openapi:generate": "npm run build:api && node --import tsx scripts/openapi-artifact.ts generate",
    "release": "node scripts/release.mjs",
    "sdk:build": "node scripts/build-sdk.mjs",
    "sdk:pack": "node scripts/pack-client.mjs sdk",
    "sdk:typecheck": "tsc -p apps/cli/tsconfig.sdk.build.json --noEmit",
    "start": "node dist/api/main.js",
    "start:dev": "node scripts/run-local.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:api": "vitest run --config vitest.http.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "node scripts/run-playwright.mjs e2e",
    "test:instance": "node --test scripts/instance.spec.mjs scripts/local-app.spec.mjs scripts/verify.spec.mjs scripts/deploy.spec.mjs scripts/release.spec.mjs",
    "test:sdk": "vitest run --config vitest.config.ts tests/sdk",
    "test:cli": "vitest run --config vitest.config.ts tests/cli",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:visual": "node scripts/run-playwright.mjs visual",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "orval": "8.28.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "$fastify"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "fsevents": false
  }
}
