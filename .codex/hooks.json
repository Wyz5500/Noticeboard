{
  "description": "Start and stop the local preview server with the Codex session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/preview_server.py\" start >/dev/null",
            "timeout": 10,
            "statusMessage": "Starting local preview server"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/preview_server.py\" stop >/dev/null",
            "timeout": 3,
            "statusMessage": "Stopping local preview server"
          }
        ]
      }
    ]
  }
}
